{
  "family": "dev-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::750702272155:role/dev-ecs-execution-role",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "750702272155.dkr.ecr.ap-south-1.amazonaws.com/infra-as-code-pipeline-dev:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
